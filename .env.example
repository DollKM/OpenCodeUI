# ============================================
# OpenCode WebUI - 环境变量
# ============================================
# 用于本地开发或自行部署
# 复制此文件为 .env 并填入所需配置

# ---- LLM Provider API Keys（可选，本地开发时 opencode serve 自己管理）----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=

# ---- 本地开发 Vite 使用的 API 地址（可选）----
# 默认代理到 http://127.0.0.1:4096
VITE_API_BASE_URL=
